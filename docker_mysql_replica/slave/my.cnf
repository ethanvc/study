[mysqld]
# 服务器唯一ID，主从不能重复
server-id=2

# 开启二进制日志（从库作为其他从库的主库时需要）
log-bin=mysql-bin

# 二进制日志格式
binlog-format=ROW

# 中继日志
relay-log=mysql-relay-bin

# 从库只读（root 用户除外）
read_only=ON
super_read_only=ON

# GTID 模式
gtid-mode=ON
enforce-gtid-consistency=ON

# 从库更新也记录到binlog（如果从库作为其他从库的主库）
log-slave-updates=ON

# 字符集
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

# 最大连接数
max_connections=1000

# 跳过复制错误（生产环境慎用）
# slave-skip-errors=1062,1032

