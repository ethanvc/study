[mysqld]
# 服务器唯一ID，主从不能重复
server-id=1

# 开启二进制日志
log-bin=mysql-bin

# 二进制日志格式（推荐使用ROW）
binlog-format=ROW

# 需要复制的数据库，多个数据库用逗号分隔
# binlog-do-db=testdb

# 不需要复制的数据库
binlog-ignore-db=mysql
binlog-ignore-db=information_schema
binlog-ignore-db=performance_schema
binlog-ignore-db=sys

# binlog 过期清理时间（天）
expire_logs_days=7

# 每次事务提交时将 binlog 写入磁盘
sync-binlog=1

# GTID 模式（推荐开启）
gtid-mode=ON
enforce-gtid-consistency=ON

# 字符集
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

# 最大连接数
max_connections=1000

